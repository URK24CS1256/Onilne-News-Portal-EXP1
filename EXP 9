import React, { useState, useEffect } from "react";
import ReactDOM from "react-dom/client";

const styles = `
* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; background: #f4f3ef; color: #222; }
header { color: white; background: #111; padding: 22px 8%; display: flex; justify-content: space-between; align-items: center; }
header h1 { margin: 0; font-size: 30px; }
header span { color: #d9a441; }
.container { max-width: 900px; margin: 30px auto; padding: 0 20px; }
.search-bar { width: 100%; padding: 14px; margin-bottom: 25px; border: 1px solid #ccc; border-radius: 8px; font-size: 16px; }
.search-bar:focus { outline: 2px solid #d9a441; }
.article-card { background: white; padding: 22px; margin-bottom: 20px; border-radius: 10px; box-shadow: 0 4px 15px #ddd; border-left: 5px solid #d9a441; }
.article-card h3 { margin-top: 0; color: #111; font-size: 20px; }
.article-card p { color: #555; line-height: 1.6; font-size: 15px; }
.tag { display: inline-block; background: #111; color: #d9a441; padding: 4px 10px; border-radius: 4px; font-size: 12px; font-weight: bold; margin-bottom: 10px; }
.post-form { background: #171717; color: white; padding: 25px; border-radius: 12px; margin-bottom: 35px; }
.post-form h2 { color: #d9a441; margin-top: 0; }
.post-form input, .post-form textarea { width: 100%; padding: 12px; margin: 10px 0; border-radius: 6px; border: none; font-size: 15px; }
.post-form button { background: #d9a441; color: #111; border: none; padding: 12px 20px; font-weight: bold; border-radius: 6px; cursor: pointer; width: 100%; margin-top: 10px; }
.post-form button:hover { background: white; }
.loading { text-align: center; font-size: 18px; color: #777; margin: 40px 0; }
footer { background: #111; color: white; text-align: center; padding: 20px; margin-top: 40px; }
footer h3 { color: #d9a441; margin-bottom: 5px; }
`;

// Initial Real News Wire Data
const initialNews = [
  {
    id: 1,
    title: "Global Tech Summit 2026 Focuses on Next-Gen Artificial Intelligence",
    body: "Industry leaders gather to discuss safety benchmarks, quantum computing breakthroughs, and ethical AI deployment across global infrastructure networks."
  },
  {
    id: 2,
    title: "Chennai Metro Rail Expands Phase II Operations Across Key Corridors",
    body: "Commuters witness faster transit times as additional underground segments officially open to the public today, reducing city traffic significantly."
  },
  {
    id: 3,
    title: "SpaceX Successfully Launches Deep Space Satellite Constellation",
    body: "The Falcon Heavy rocket completed its mission to deploy high-bandwidth communications satellites into target geostationary orbits."
  },
  {
    id: 4,
    title: "Renewable Energy Capacity Reaches Record High in Q3 2026",
    body: "Solar and offshore wind farms generated over 45% of total power requirements, marking a major milestone in clean energy transition goals."
  },
  {
    id: 5,
    title: "Reserve Bank Announces Updated Guidelines for Digital Payment Services",
    body: "New cybersecurity framework and real-time transaction limits introduced to protect consumers from online financial fraud across mobile banking apps."
  }
];

export default function App() {
  const [articles, setArticles] = useState([]);
  const [searchTerm, setSearchTerm] = useState("");
  const [loading, setLoading] = useState(true);
  const [newTitle, setNewTitle] = useState("");
  const [newBody, setNewBody] = useState("");
  const [statusMsg, setStatusMsg] = useState("");

  // Simulated REST API fetch with Real News Data
  useEffect(() => {
    fetch("https://jsonplaceholder.typicode.com/posts?_limit=5")
      .then((res) => res.json())
      .then(() => {
        setArticles(initialNews);
        setLoading(false);
      })
      .catch((err) => {
        console.error("API Fetch Error:", err);
        setArticles(initialNews);
        setLoading(false);
      });
  }, []);

  // Submit Article POST request
  const handlePostSubmit = (e) => {
    e.preventDefault();
    if (!newTitle.trim() || !newBody.trim()) return;

    const newArticle = {
      id: 101,
      title: newTitle,
      body: newBody
    };

    fetch("https://jsonplaceholder.typicode.com/posts", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(newArticle),
    })
      .then(() => {
        setArticles([newArticle, ...articles]);
        setNewTitle("");
        setNewBody("");
        setStatusMsg("Article published successfully to live news feed!");
      });
  };

  const filteredArticles = articles.filter((item) =>
    item.title.toLowerCase().includes(searchTerm.toLowerCase()) ||
    item.body.toLowerCase().includes(searchTerm.toLowerCase())
  );

  return (
    <div>
      <style>{styles}</style>
      <header>
        <h1>The Daily <span>Chronicle</span></h1>
        <p style={{ color: "#d9a441", margin: 0, fontWeight: "bold" }}>REST API Live Feed</p>
      </header>

      <div className="container">
        {/* Editorial Submission Form */}
        <div className="post-form">
          <h2>Submit Breaking News Release</h2>
          <form onSubmit={handlePostSubmit}>
            <input
              placeholder="Article Headline"
              value={newTitle}
              onChange={(e) => setNewTitle(e.target.value)}
            />
            <textarea
              rows="3"
              placeholder="Article Summary / Main Body"
              value={newBody}
              onChange={(e) => setNewBody(e.target.value)}
            />
            <button type="submit">Publish Article</button>
          </form>
          {statusMsg && <p style={{ color: "#4CAF50", fontWeight: "bold", marginTop: "10px" }}>{statusMsg}</p>}
        </div>

        {/* Live Search Filter */}
        <input
          type="text"
          className="search-bar"
          placeholder="Search live news headlines..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
        />

        {/* Dynamic Articles List */}
        <h2>Latest Wire Headlines</h2>
        {loading ? (
          <div className="loading">Fetching live news wire...</div>
        ) : (
          filteredArticles.map((article) => (
            <div key={article.id} className="article-card">
              <span className="tag">CHRONICLE WIRE #{article.id}</span>
              <h3>{article.title}</h3>
              <p>{article.body}</p>
            </div>
          ))
        )}
      </div>

      <footer>
        <h3>The Daily Chronicle Media Network</h3>
        <p>© 2026-2027 | Sharvesh S | URK24CS1256 | Web Technology Lab</p>
      </footer>
    </div>
  );
}

const rootElement = document.getElementById("root");
if (rootElement) {
  ReactDOM.createRoot(rootElement).render(
    <React.StrictMode>
      <App />
    </React.StrictMode>
  );
}
