<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Online News Portal</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        body{
            font-family:Arial, sans-serif;
            background:#f4f4f4;
            line-height:1.6;
        }

        /* Header */
        header{
            background:#c0392b;
            color:white;
            text-align:center;
            padding:20px;
        }

        /* Navigation */
        nav{
            background:#333;
        }

        nav ul{
            display:flex;
            justify-content:center;
            list-style:none;
        }

        nav li{
            padding:15px;
        }

        nav a{
            color:white;
            text-decoration:none;
        }

        nav li:hover{
            background:#c0392b;
        }

        /* Hero Section */
        .hero{
            background:#fdecea;
            text-align:center;
            padding:50px;
        }

        /* Main Container */
        .container{
            display:flex;
            gap:20px;
            padding:20px;
        }

        /* Sidebar */
        .sidebar{
            width:25%;
            background:white;
            padding:20px;
            border-radius:10px;
        }

        .sidebar ul{
            list-style:none;
        }

        .sidebar li{
            padding:10px;
            border-bottom:1px solid gray;
        }

        /* Content */
        .content{
            width:75%;
        }

        /* Cards */
        .cards{
            display:flex;
            gap:20px;
            margin-top:20px;
        }

        .card{
            flex:1;
            background:white;
            padding:20px;
            border-radius:10px;
            text-align:center;
            box-shadow:0 0 8px gray;
        }

        .card img{
            width:100%;
            height:auto;
            border-radius:10px;
        }

        button{
            background:#c0392b;
            color:white;
            border:none;
            padding:10px 20px;
            margin-top:10px;
            cursor:pointer;
        }

        button:hover{
            background:#922b21;
        }

        /* Footer */
        footer{
            background:#333;
            color:white;
            text-align:center;
            padding:20px;
            margin-top:20px;
        }

        /* Tablet View */
        @media screen and (max-width:992px){

            .container{
                flex-direction:column;
            }

            .sidebar,
            .content{
                width:100%;
            }

            .cards{
                flex-wrap:wrap;
            }

            .card{
                width:45%;
            }
        }

        /* Mobile View */
        @media screen and (max-width:768px){

            nav ul{
                flex-direction:column;
            }

            .cards{
                flex-direction:column;
            }

            .card{
                width:100%;
            }

            .hero{
                padding:30px;
            }
        }

        /* Small Mobile */
        @media screen and (max-width:480px){

            header h1{
                font-size:24px;
            }

            .hero h2{
                font-size:22px;
            }

            button{
                width:100%;
            }
        }

    </style>
</head>

<body>

    <header>
        <h1>Online News Portal</h1>
        <p>Latest News and Updates</p>
    </header>

    <nav>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">National</a></li>
            <li><a href="#">International</a></li>
            <li><a href="#">Sports</a></li>
            <li><a href="#">Technology</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <section class="hero">

        <h2>Stay Updated, Stay Informed</h2>

        <p>
            Welcome to our Online News Portal.
            Get the latest updates from national, international,
            sports, and technology news.
        </p>

    </section>

    <div class="container">

        <div class="sidebar">

            <h3>News Categories</h3>

            <ul>
                <li>Breaking News</li>
                <li>National News</li>
                <li>International News</li>
                <li>Sports News</li>
                <li>Technology</li>
                <li>Entertainment</li>
            </ul>

        </div>

        <div class="content">

            <h2>Latest News</h2>

            <p>
                Stay informed with the latest news and important
                updates happening around the world.
            </p>

            <div class="cards">

                <div class="card">

                    <img src="https://picsum.photos/300/200?news"
                         alt="Breaking News">

                    <h3>Breaking News</h3>

                    <p>
                        Get the latest breaking news and important
                        updates from around the world.
                    </p>

                    <button>Read More</button>

                </div>


                <div class="card">

                    <img src="https://picsum.photos/300/200?sports"
                         alt="Sports News">

                    <h3>Sports News</h3>

                    <p>
                        Follow the latest sports events, match results,
                        scores, and updates.
                    </p>

                    <button>Read More</button>

                </div>


                <div class="card">

                    <img src="https://picsum.photos/300/200?technology"
                         alt="Technology News">

                    <h3>Technology News</h3>

                    <p>
                        Discover the latest developments in technology,
                        gadgets, and innovation.
                    </p>

                    <button>Read More</button>

                </div>

            </div>

        </div>

    </div>

    <footer>

        <h3>Online News Portal</h3>

        <p>&copy; 2026 Online News Portal</p>

        <p><strong>Name:</strong>Sharvesh S</p>

        <p><strong>Reg No:</strong>URK24CS1256</p>

    </footer>

</body>
</html>
