<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online News Portal - Article & Reader Hub</title>
    
    <style>
        /* CSS Styling */
        * {
            box-sizing: border-box;
            font-family: Georgia, Garamond, 'Times New Roman', serif;
        }

        body {
            margin: 0;
            background: #f4f6f8;
            color: #222222;
        }

        /* Header Section */
        header {
            background: linear-gradient(135deg, #1c334d, #2b6cb0);
            color: white;
            text-align: center;
            padding: 25px 15px;
        }

        header h1 {
            margin: 0;
            font-size: 32px;
            letter-spacing: 1px;
        }

        header p {
            margin: 6px 0 0;
            font-size: 18px;
            font-style: italic;
        }

        /* General Container Sections */
        section {
            max-width: 900px;
            margin: 20px auto;
            padding: 0 15px;
        }

        /* Search and Filter Controls */
        .controls {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            justify-content: center;
        }

        .controls input,
        .controls select {
            padding: 10px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            font-size: 16px;
        }

        .controls input {
            flex: 1 1 300px;
        }

        /* Form Section */
        .form-section fieldset {
            background: white;
            border: 1px solid #cbd5e0;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .form-section label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #1c334d;
        }

        .form-section input,
        .form-section select,
        .form-section textarea {
            width: 100%;
            padding: 8px;
            margin-top: 4px;
            margin-bottom: 12px;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            font-size: 16px;
        }

        /* Button Styling */
        button {
            cursor: pointer;
            border: none;
            border-radius: 6px;
            padding: 10px 18px;
            font-size: 16px;
            font-weight: bold;
        }

        #addBtn {
            background: #e50914;
            color: white;
        }

        #addBtn:hover {
            background: #b80710;
        }

        #clearBtn {
            background: #718096;
            color: white;
        }

        #clearBtn:hover {
            background: #4a5568;
        }

        /* Error Message Display */
        .error {
            color: #e50914;
            margin-left: 10px;
            font-size: 14px;
        }

        /* Statistics Board */
        .stats {
            background: white;
            border-radius: 10px;
            padding: 15px 20px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .stats h2 {
            margin-top: 0;
            color: #1c334d;
        }

        .stats p {
            margin: 6px 0;
        }

        #totalCount,
        #avgRating,
        #topPost {
            font-weight: bold;
            color: #e50914;
        }

        /* Article Cards Grid Display */
        #postContainer {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 15px;
        }

        .post-card {
            background: white;
            border-left: 5px solid #1c334d;
            border-radius: 8px;
            padding: 15px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
            position: relative;
        }

        .post-card h3 {
            margin: 0 0 6px;
            font-size: 20px;
            color: #1c334d;
        }

        .post-card .category {
            display: inline-block;
            background: #e2e8f0;
            color: #2b6cb0;
            font-size: 14px;
            padding: 2px 8px;
            border-radius: 12px;
            margin-bottom: 8px;
            font-weight: bold;
        }

        .post-card .stars {
            color: #f59e0b;
            font-size: 18px;
        }

        .post-card p.text {
            font-size: 15px;
            color: #4a5568;
            margin: 8px 0;
            line-height: 1.5;
        }

        /* Delete Button */
        .delete-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: #edf2f7;
            color: #e50914;
            padding: 3px 8px;
            font-size: 14px;
            border-radius: 5px;
        }

        .delete-btn:hover {
            background: #e50914;
            color: white;
        }

        /* No Results Notice */
        .no-results {
            text-align: center;
            color: #718096;
            font-style: italic;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 15px;
            font-size: 15px;
            color: #718096;
        }

        /* Responsive Breakpoints */
        @media (max-width: 600px) {
            header h1 {
                font-size: 25px;
            }

            .controls {
                flex-direction: column;
            }

            .controls input,
            .controls select,
            .controls button {
                width: 100%;
            }
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <h1>The Daily Chronicle</h1>
        <p>Online News Portal — Verified Real-Time Global Reporting</p>
    </header>

    <!-- Search & Filter Controls -->
    <section class="controls">
        <input type="text" id="searchBox" placeholder="Search news stories or topics...">
        <select id="filterRating">
            <option value="all">All Rating Levels</option>
            <option value="5">5 Stars (Featured)</option>
            <option value="4">4 Stars (High Rating)</option>
            <option value="3">3 Stars (Standard)</option>
            <option value="2">2 Stars (Low Rating)</option>
            <option value="1">1 Star (Unrated)</option>
        </select>
        <button id="clearBtn">Clear All Articles</button>
    </section>

    <!-- Add News Article Section -->
    <section class="form-section">
        <h2>Submit a News Story / Reader Report</h2>
        <fieldset>
            <label for="postTitle">Headline / Story Title:</label>
            <input type="text" id="postTitle" placeholder="Enter news headline...">

            <label for="postCategory">News Desk Category:</label>
            <select id="postCategory">
                <option value="World News">World News</option>
                <option value="Technology">Technology</option>
                <option value="Business & Markets">Business & Markets</option>
                <option value="Sports">Sports</option>
                <option value="Editorial">Editorial</option>
            </select>

            <label for="postRating">Editorial Impact Rating:</label>
            <select id="postRating">
                <option value="5">5 Stars (Featured Story)</option>
                <option value="4">4 Stars (Major Coverage)</option>
                <option value="3">3 Stars (Standard Report)</option>
                <option value="2">2 Stars (Minor Update)</option>
                <option value="1">1 Star (Brief Note)</option>
            </select>

            <label for="postText">Article Summary / Content:</label>
            <textarea id="postText" rows="3" placeholder="Write full article description here..."></textarea>

            <button id="addBtn">Publish Story</button>
            <span id="errorMsg" class="error"></span>
        </fieldset>
    </section>

    <!-- Portal Statistics Board -->
    <section class="stats">
        <h2>Newsroom Statistics</h2>
        <p>Total Articles Published: <span id="totalCount">0</span></p>
        <p>Average Editorial Rating: <span id="avgRating">0.0</span></p>
        <p>Top Impact Story: <span id="topPost">—</span></p>
    </section>

    <!-- News Stories Display Section -->
    <section class="reviews-section">
        <h2>Published News Feed</h2>
        <div id="postContainer"></div>
        <p id="noResults" class="no-results" style="display:none;">
            No news articles match your current search criteria.
        </p>
    </section>

    <!-- Footer Section -->
    <footer>
        <p>The Daily Chronicle — Online News Portal</p>
        <p>Copyright 2026-2027 | URK24CS1256 | Web Technology Lab</p>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        /* 1. DOM Element References */
        const postTitle = document.getElementById("postTitle");
        const postCategory = document.getElementById("postCategory");
        const postRating = document.getElementById("postRating");
        const postText = document.getElementById("postText");
        const addBtn = document.getElementById("addBtn");
        const clearBtn = document.getElementById("clearBtn");
        const errorMsg = document.getElementById("errorMsg");
        const postContainer = document.getElementById("postContainer");
        const noResults = document.getElementById("noResults");
        const searchBox = document.getElementById("searchBox");
        const filterRating = document.getElementById("filterRating");
        const totalCount = document.getElementById("totalCount");
        const avgRating = document.getElementById("avgRating");
        const topPost = document.getElementById("topPost");

        /* 2. Primary News Data Array */
        let posts = [];

        /* 3. Add News Article Handler */
        function addPost() {
            const title = postTitle.value.trim();
            const category = postCategory.value;
            const rating = parseInt(postRating.value);
            const text = postText.value.trim();

            if (title === "" || text === "") {
                errorMsg.textContent = "Please enter a headline and story summary.";
                return;
            }

            errorMsg.textContent = "";

            const post = {
                id: Date.now(),
                title: title,
                category: category,
                rating: rating,
                text: text
            };

            posts.push(post);

            // Reset Inputs
            postTitle.value = "";
            postText.value = "";
            postRating.value = "5";

            renderPosts();
            updateStats();
        }

        /* 4. Render Articles to DOM */
        function renderPosts() {
            const searchTerm = searchBox.value.toLowerCase().trim();
            const ratingFilter = filterRating.value;

            const filtered = posts.filter(function(p) {
                const matchesSearch =
                    p.title.toLowerCase().includes(searchTerm) ||
                    p.category.toLowerCase().includes(searchTerm) ||
                    p.text.toLowerCase().includes(searchTerm);

                const matchesRating =
                    ratingFilter === "all" ||
                    p.rating === parseInt(ratingFilter);

                return matchesSearch && matchesRating;
            });

            postContainer.innerHTML = "";

            if (filtered.length === 0) {
                noResults.style.display = "block";
                return;
            }

            noResults.style.display = "none";

            filtered.forEach(function(p) {
                const card = document.createElement("div");
                card.className = "post-card";

                const titleEl = document.createElement("h3");
                titleEl.textContent = p.title;

                const categoryEl = document.createElement("span");
                categoryEl.className = "category";
                categoryEl.textContent = p.category;

                const starsEl = document.createElement("div");
                starsEl.className = "stars";
                starsEl.textContent = "★".repeat(p.rating) + "☆".repeat(5 - p.rating);

                const textEl = document.createElement("p");
                textEl.className = "text";
                textEl.textContent = p.text;

                const delBtn = document.createElement("button");
                delBtn.className = "delete-btn";
                delBtn.textContent = "Delete";
                delBtn.addEventListener("click", function() {
                    deletePost(p.id);
                });

                card.appendChild(titleEl);
                card.appendChild(categoryEl);
                card.appendChild(starsEl);
                card.appendChild(textEl);
                card.appendChild(delBtn);

                postContainer.appendChild(card);
            });
        }

        /* 5. Delete News Article */
        function deletePost(id) {
            posts = posts.filter(function(p) {
                return p.id !== id;
            });
            renderPosts();
            updateStats();
        }

        /* 6. Calculate & Update Portal Statistics */
        function updateStats() {
            const total = posts.length;
            totalCount.textContent = total;

            if (total === 0) {
                avgRating.textContent = "0.0";
                topPost.textContent = "—";
                return;
            }

            const sum = posts.reduce(function(acc, p) {
                return acc + p.rating;
            }, 0);

            avgRating.textContent = (sum / total).toFixed(1);

            let best = posts[0];
            posts.forEach(function(p) {
                if (p.rating > best.rating) {
                    best = p;
                }
            });

            topPost.textContent = best.title + " (" + best.rating + " Stars)";
        }

        /* 7. Register Event Listeners */
        addBtn.addEventListener("click", addPost);
        searchBox.addEventListener("keyup", renderPosts);
        filterRating.addEventListener("change", renderPosts);

        clearBtn.addEventListener("click", function() {
            if (posts.length === 0) return;
            if (confirm("Are you sure you want to delete all news stories?")) {
                posts = [];
                renderPosts();
                updateStats();
            }
        });

        postTitle.addEventListener("keydown", function(e) {
            if (e.key === "Enter") {
                e.preventDefault();
                addPost();
            }
        });

        /* 8. Initial Pre-loaded Sample Stories */
        window.addEventListener("load", function() {
            posts.push({
                id: 1,
                title: "Global Tech Summit 2026 Keynote",
                category: "Technology",
                rating: 5,
                text: "Industry pioneers gather to demonstrate breakthroughs in AI models and energy grid automation."
            });

            posts.push({
                id: 2,
                title: "Global Financial Markets Update",
                category: "Business & Markets",
                rating: 4,
                text: "Stock indices show strong quarterly gains as international trading volume accelerates."
            });

            posts.push({
                id: 3,
                title: "International Renewable Grid Expansion",
                category: "World News",
                rating: 5,
                text: "Cross-border solar and wind projects receive regulatory approval across three continents."
            });

            renderPosts();
            updateStats();
        });
    </script>
</body>
</html>
