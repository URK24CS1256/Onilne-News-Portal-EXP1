<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Daily Chronicle - Online News Portal</title>
    <!-- Internal CSS for styling background and text colors -->
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            color: #222222;
            margin: 0;
            padding: 20px;
            line-height: 1.6;
        }
        header, section, footer {
            background-color: #ffffff;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        h1 {
            color: #1a365d;
        }
        h2, h3 {
            color: #2b6cb0;
        }
        a {
            color: #3182ce;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        table, th, td {
            border: 1px solid #cbd5e0;
        }
        th, td {
            padding: 10px;
            text-align: left;
        }
        th {
            background-color: #e2e8f0;
        }
    </style>
</head>
<body>

    <!-- Header Section / Top Navigation -->
    <div id="top">
        <header>
            <!-- Main Heading (h1) -->
            <h1>The Daily Chronicle</h1>
            <p><em>Your trusted source for global news, tech, and sports.</em></p>
            
