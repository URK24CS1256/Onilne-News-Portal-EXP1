            <!-- Description List (dl, dt, dd) -->
            <h3>Journalism Glossary</h3>
            <dl>
                <dt><strong>Headline</strong></dt>
                <dd>The title of a news article, designed to summarize the content and draw readers' attention.</dd>
                
                <dt><strong>Byline</strong></dt>
                <dd>A line in a newspaper naming the writer of an article.</dd>
                
                <dt><strong>Editorial</strong></dt>
                <dd>An article presenting the opinion of the newspaper or publisher.</dd>
            </dl>
